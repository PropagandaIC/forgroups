# Database PostgreSQL
# In locale: sostituisci PASSWORD con quella scelta installando PostgreSQL (Postgres.app su Mac: togli ":PASSWORD")
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/forgroups"

# Segreto per firmare le sessioni: in produzione almeno 32 caratteri casuali (openssl rand -base64 48)
SESSION_SECRET="prova-locale-cambiami-0123456789abcdefghijklmnop"

# Indirizzo del sito (usato nei link di pagamento e nei preventivi)
APP_URL="http://localhost:3000"

# Stripe Connect (consigliata una restricted key "rk_live_…" / "rk_test_…")
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Assistente AI per le richieste da email (Claude)
ANTHROPIC_API_KEY=""
